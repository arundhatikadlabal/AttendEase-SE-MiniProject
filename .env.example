
DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=attendease
POSTGRES_USER=attendease
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email: console backend prints messages locally without delivering them.
# For real delivery use django.core.mail.backends.smtp.EmailBackend and set
# provider credentials in the environment or a private, untracked .env file.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=AttendEase <no-reply@example.com>
